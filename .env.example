# ============================================
# AlertaMujer - Environment variables
# Copy this file to .env and adjust the values
# ============================================

# PostgreSQL
POSTGRES_USER=alerta_mujer
POSTGRES_PASSWORD=
POSTGRES_DB=alerta_mujer

# JWT (required): generate a random one with  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=24h

# CORS (comma separated for several origins)
CORS_ORIGIN=http://localhost:*,http://127.0.0.1:*

# Password of the runtime database user alerta_app (no DDL privileges). Generate one with: openssl rand -hex 24
APP_DB_PASSWORD=

# Emails to the emergency contacts: log (only writes to the log), resend or brevo
EMAIL_PROVIDER=log
EMAIL_API_KEY=
# Sender from a domain verified with the provider, e.g. AlertaMujer <alertas@your-domain.com>
EMAIL_FROM=
# Web panel where the tracking link in the email opens
WEB_BASE_URL=http://localhost:4200

# Internal key shared by the 3 services (required): generate one with  openssl rand -hex 24
INTERNAL_API_KEY=
