# ============================================
# AlertaMujer - Variables de entorno
# Copia este archivo como .env y ajusta los valores
# ============================================

# PostgreSQL
POSTGRES_USER=alerta_mujer
POSTGRES_PASSWORD=alerta_mujer_2026
POSTGRES_DB=alerta_mujer

# JWT (obligatorio): genera uno aleatorio con  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=24h

# CORS (separados por coma para múltiples orígenes)
CORS_ORIGIN=http://localhost:*,http://127.0.0.1:*

# Usuario de runtime del backend (alerta_app, sin privilegios de DDL). Genera uno con: openssl rand -hex 24
APP_DB_PASSWORD=

# Correos a los contactos de emergencia: log (solo escribe en el log), resend o brevo
EMAIL_PROVIDER=log
EMAIL_API_KEY=
# Remitente de un dominio verificado en el proveedor, p. ej. AlertaMujer <alertas@tu-dominio.com>
EMAIL_FROM=
# Panel web donde se abre el enlace de seguimiento que llega en el correo
WEB_BASE_URL=http://localhost:4200
